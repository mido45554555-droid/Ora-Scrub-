# Copy this file to .env.local and fill in real values.
# Never commit .env.local.

# Where the Node.js order backend (../backend) listens. Server-side
# only — the browser never sees it; app/api/order/route.ts proxies to it.
ORDER_BACKEND_URL=http://127.0.0.1:4000

# Must equal INTERNAL_API_KEY in ../backend/.env. Server-side only:
# never prefix it with NEXT_PUBLIC_.
ORDER_BACKEND_API_KEY=123456789123
