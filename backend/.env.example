# Copy to .env (or run `npm run setup`, which creates it with random
# secrets for you). Never commit .env.

NODE_ENV=development

# The API listens on loopback only. The Next.js site proxies to it
# server-side, so it never needs to be reachable from the internet.
HOST=127.0.0.1
PORT=4000

# MariaDB/MySQL — a dedicated, least-privilege user (not root).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ora_scrubs
DB_USER=ora_app
DB_PASSWORD=

# Shared secret sent by the Next.js proxy on every request. Must match
# ORDER_BACKEND_API_KEY in the frontend's .env.local. At least 32 chars.
INTERNAL_API_KEY=

# Where uploaded images are stored. Keep this OUTSIDE any web-served
# folder in production (e.g. not under htdocs / public_html).
STORAGE_DIR=./storage

# Admin login session lifetime, in hours.
ADMIN_SESSION_HOURS=12

# Public order submissions allowed per client IP per 15 minutes, and
# across all clients combined (a backstop against spoofed-IP floods).
ORDER_RATE_LIMIT=5
ORDER_GLOBAL_RATE_LIMIT=100

# Total size (MB) of uploads being checked in memory at the same time.
# Small orders barely count, so hundreds run at once; only large ones
# queue, and they wait for a slot instead of being refused.
UPLOAD_MEMORY_MB=150

# --- New-order email -------------------------------------------------
# Each new order is emailed here, with its images attached. Separate
# several addresses with commas. Leave SMTP_* empty to disable emails
# (orders are still saved).
ORDER_NOTIFY_TO=orascrubs@gmail.com

# Free option 1 — Gmail (500 emails/day). SMTP_PASS is NOT the normal
# Gmail password: turn on 2-Step Verification, then create an App
# Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=orascrubs@gmail.com
SMTP_PASS=
# Free option 2 — Brevo (300 emails/day): SMTP_HOST=smtp-relay.brevo.com,
# SMTP_PORT=587, SMTP_SECURE=false, SMTP_USER/SMTP_PASS from Brevo's
# "SMTP & API" page, and MAIL_FROM set to a sender verified in Brevo.

# Optional; defaults to "ORA Orders <SMTP_USER>".
MAIL_FROM=

# Only used by `npm run setup` to create the database and app user.
# XAMPP's default is root with an empty password.
DB_ROOT_USER=root
DB_ROOT_PASSWORD=
