# Copy to .env (or run `npm run setup`, which creates it with random
# secrets for you). Never commit .env.

NODE_ENV=development

# Bind on all interfaces so Railway's service proxy can reach the API.
HOST=0.0.0.0
PORT=4000

# MariaDB/MySQL — a dedicated, least-privilege user (not root).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ora_scrubs
DB_USER=ora_app
DB_PASSWORD=

# Shared secret sent by the Next.js proxy on every request. Must match
# ORDER_BACKEND_API_KEY in the frontend's .env.local. Replace with a random
# value of at least 32 characters.
INTERNAL_API_KEY=replace-with-at-least-32-random-characters

# Where uploaded images are stored. Keep this OUTSIDE any web-served
# folder in production (e.g. not under htdocs / public_html).
STORAGE_DIR=./storage

# Admin login session lifetime, in hours.
ADMIN_SESSION_HOURS=12

# Saturday-based order processing batches use this server-side timezone.
# Browser timezone is never used for queue allocation.
PROCESSING_TIME_ZONE=Africa/Cairo

# Public site origin used for privileged one-time links in shop order emails.
# Use the deployed HTTPS origin in production.
PUBLIC_SITE_URL=http://localhost:3000

# Order submissions allowed per 15 minutes:
# - per browser, per IP, and across all clients as a backstop.
ORDER_RATE_LIMIT=5
ORDER_IP_RATE_LIMIT=30
ORDER_GLOBAL_RATE_LIMIT=100

# How many order uploads may stream to disk at the same time. Excess
# requests receive 503 + Retry-After rather than waiting for a slot.
UPLOAD_CONCURRENCY=4

# --- New-order email -------------------------------------------------
# Each new order is emailed here, with its images attached. Separate
# several addresses with commas. Leave these settings empty to disable emails
# (orders are still saved).
ORDER_NOTIFY_TO=orascrubs@gmail.com

RESEND_API_KEY=
# Must be an address on a domain verified in Resend for production sending.
MAIL_FROM=

# Only used by `npm run setup` to create the database and app user.
# XAMPP's default is root with an empty password.
DB_ROOT_USER=root
DB_ROOT_PASSWORD=
